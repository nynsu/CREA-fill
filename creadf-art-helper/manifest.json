{
  "manifest_version": 3,
  "name": "CREA-DF ART",
  "version": "1.4.0",
  "description": "Extrai dados de mensagens (DSEI/Aldeias), converte coordenadas GMS para decimal e preenche o formulário de ART do CREA-DF.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "clipboardRead"
  ],
  "host_permissions": [
    "https://art.creadf.org.br/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Abrir PREENCHEDOR AUTOMÁTICO DE ART SUPER PODEROSO CASEIRO",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
